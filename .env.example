# Discord Webhook URL (Alternative smooth notification system)
# Create one in Discord: Channel Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Telegram Bot Notifications (Highly recommended for phone alerts)
# 1. Message @BotFather on Telegram to create a bot and get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot to get your personal TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facebook Page Notifications
# Requires a Facebook App with Page Public Metadata or Manage Pages permissions
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
